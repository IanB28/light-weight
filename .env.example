# Environment Configuration Example

# API Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/light_weight_db

# Authentication / Security
JWT_SECRET=replace_with_a_secure_random_string_in_production
SESSION_SECRET=replace_with_another_secure_string

# Operator Account (Initial provisioning)
OPERATOR_EMAIL=admin@lightweight.local
OPERATOR_INITIAL_PASSWORD=change_me_immediately

# Web Client Configuration
VITE_API_BASE_URL=http://localhost:4000/api
