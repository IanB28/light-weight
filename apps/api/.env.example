PORT=4000
NODE_ENV=development
# Use Neon's pooled connection URL in Vercel; never commit a real value.
DATABASE_URL="postgresql://username:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Development origins. In the Vercel API Production environment set exactly:
# WEB_ORIGINS="https://uselightweight.me"
WEB_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Cookies are Secure automatically when NODE_ENV=production and are not Secure
# in development. Override only for an intentional HTTPS/proxy deployment.
# SESSION_COOKIE_SECURE=true
# Google OAuth 2.0 Web Client ID for server-side ID token verification
# GOOGLE_CLIENT_ID="1234567890-abcdef.apps.googleusercontent.com"
