# Environment Configuration Example

# API Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/light_weight_db

# Web Client Configuration for local development
VITE_API_URL=http://localhost:4000

# Vercel Web Production environment (set this in the Vercel dashboard, not here):
# VITE_API_URL=https://api.uselightweight.me
